{
  "name": "@kuutti-ry/tunnistus-oidc",
  "version": "0.1.1",
  "description": "Telia Tunnistus relying-party kit for Node: the OpenID Connect client the broker's integration guide asks for (signed request object, private_key_jwt, encrypted ID token), discovery, key helpers, the Finnish personal identity code format, and an in-process test double of the broker.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuutti-ry/tunnistus-oidc.git"
  },
  "homepage": "https://github.com/kuutti-ry/tunnistus-oidc#readme",
  "bugs": "https://github.com/kuutti-ry/tunnistus-oidc/issues",
  "keywords": [
    "telia",
    "tunnistus",
    "finnish-trust-network",
    "ftn",
    "openid-connect",
    "oidc",
    "strong-authentication",
    "henkilotunnus",
    "hetu"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hetu": {
      "types": "./dist/hetu.d.ts",
      "default": "./dist/hetu.js"
    },
    "./testing": {
      "types": "./dist/testing/fake-telia.d.ts",
      "default": "./dist/testing/fake-telia.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts",
    "check:tarball": "node scripts/check-tarball.ts"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "hono": "^4.13.14"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "hono": "^4.13.14",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  }
}
